PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Speech Provider Configuration (Optional - defaults to mock provider if unset)
# STT_PROVIDER: mock | deepgram | sarvam | google
STT_PROVIDER=mock
# TTS_PROVIDER: google-tts (Real, keyless) | mock | google | azure
TTS_PROVIDER=google-tts

# Deepgram STT (Optional)
DEEPGRAM_API_KEY=

# Sarvam AI STT (Optional - specialist Indian English)
SARVAM_API_KEY=

# Google Cloud STT / TTS (Optional - service account)
GOOGLE_APPLICATION_CREDENTIALS=

